    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^9.2.4",
    "cn": "^0.3.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
