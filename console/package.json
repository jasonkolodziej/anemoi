{
  "name": "anemoi-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "readme": "console/README.md",
  "scripts": {
    "sync-wiki": "node scripts/sync-wiki.mjs",
    "dev": "pnpm run sync-wiki && vite dev",
    "build": "pnpm run sync-wiki && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "prepare": "svelte-kit sync || echo ''",
    "check": "pnpm run sync-wiki && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:errors": "pnpm run check --threshold error",
    "check:warnings": "pnpm run check --threshold warning",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "shad:add": "pnpm dlx shadcn-svelte@latest add",
    "shad:apply": "pnpm dlx shadcn-svelte@latest apply"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^9.2.4",
    "@types/d3-polygon": "^3.0.2",
    "@types/node": "^26.6.4",
    "cn": "^0.3.3",
    "formsnap": "^2.0.1",
    "layerchart": "^2.5.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "runed": "^0.37.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "sveltekit-superforms": "^2.31.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.49.0",
    "@tanstack/svelte-table": "^9.2.4",
    "arktype": "^2.2.7",
    "better-auth": "^1.7.7",
    "bits-ui": "^2.19.4",
    "clsx": "^2.1.1",
    "d3-polygon": "^3.0.1",
    "d3-scale": "^4.0.2",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "maplibre-gl": "^6.11.2",
    "mermaid": "^12.0.0",
    "minisearch": "^7.2.0",
    "svelte-guard": "^1.1.1",
    "svelte-maplibre-gl": "^2.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
