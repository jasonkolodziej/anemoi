{
	// Cloudflare deployment for the console (issue #96, promoted off pure
	// static assets by #171). `main` now points at the Worker
	// `@sveltejs/adapter-cloudflare` emits -- #171 gives the console real
	// login (session cookies, D1-backed), API-key issuance, and a
	// same-origin proxy to anemoi-api-real, none of which a static-assets-
	// only deployment can run (`+page.server.ts`/`+server.ts` need a server
	// runtime). See console/vite.config.ts for the adapter switch.
	//
	// New projects get Workers-with-static-assets over the older, separate
	// Cloudflare Pages product per Cloudflare's own current guidance --
	// full feature parity as of 2026, and this keeps the same wrangler-based
	// tooling already used for docker/api's deployment (#91).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "anemoi-console",
	"compatibility_date": "2026-09-21",
	"main": ".svelte-kit/cloudflare/_worker.js",

	// anemoi.systems is the console's real domain. `workers_dev` defaults to
	// *disabled* the moment `routes` is present at all -- set explicitly so
	// the workers.dev URL stays live too, additive rather than a cutover.
	"routes": [{ "pattern": "anemoi.systems", "custom_domain": true }],
	"workers_dev": true,

	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
	},

	// Shared with docker/api/wrangler.jsonc -- both Workers bind the same
	// database so anemoi-api-real can verify a console-issued API key
	// without a second copy of the user/key data. Create with
	// `wrangler d1 create anemoi_auth`. Schema lives in console/migrations/
	// (`wrangler d1 migrations apply anemoi_auth --local|--remote`); the
	// Deploy workflow (.github/workflows/deploy.yml) applies new ones to
	// production.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "anemoi_auth",
			"database_id": "92bff5ef-6d73-4188-a75a-c763bac6a0e6",
			"migrations_dir": "migrations",
		},
	],

	// better-auth's magicLink/emailOTP plugins send through this (see
	// src/lib/server/email.ts). Requires Email Routing enabled on
	// anemoi.systems in the dashboard before it can send anything real;
	// falls back to a console.warn in local dev when unbound.
	"send_email": [{ "name": "SEND_EMAIL" }],

	// Console -> anemoi-api-real, in-process (no CORS, no public hop).
	// Used by the console Worker's own API routes once a session is
	// resolved, to attach the user's real API key server-side -- the
	// browser never sees it. See docker/api/wrangler.jsonc for the other
	// side of this binding.
	"services": [{ "binding": "ANEMOI_API", "service": "anemoi-api-real" }],
}
