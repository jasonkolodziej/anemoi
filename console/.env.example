# Copy to .env for local dev, or set in the environment before `pnpm build`
# for a real deploy -- see src/lib/api/client.ts's comment on why this is
# effectively build-time, not true per-request runtime config, despite
# using $env/dynamic/public.

# Defaults to http://127.0.0.1:8000 (the reference `uv run python -m
# anemoi.api` default) if unset -- only needed to point at something else,
# e.g. the deployed real-mode API:
# PUBLIC_ANEMOI_API_URL=https://anemoi-api-real.jasonkolodziej.workers.dev
