{
	// Cloudflare Containers config for issue #91's primary proposal: real-mode
	// Anemoi-API (torch inference, see ../Dockerfile) as a real linux/amd64
	// container, fronted by this Worker. Deployed and live -- see
	// docker/api/README.md for status, required secrets, and how to deploy.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "anemoi-api-real",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",

	// Fires the real operational cycle for every active storm (src/index.ts's
	// `scheduled` handler) -- nothing did this before (#178);
	// every cycle in production until now was a manual POST. UTC, t+1:30
	// after each synoptic time (00/06/12/18Z), 10 minutes past the real
	// TC-Vitals timeout (`scheduler.derive_vitals_timeout()`, t+1:20) so the
	// vitals-vs-fallback question is already honestly resolved by fire time.
	"triggers": {
		"crons": ["30 1,7,13,19 * * *"],
	},

	"containers": [
		{
			"class_name": "AnemoiRealApi",
			"image": "./Dockerfile",
			// The Dockerfile's COPY instructions (pyproject.toml, src/, etc.)
			// expect the repo root as the build context, not this directory --
			// `image_build_context` defaults to the Dockerfile's own directory,
			// which fails with "pyproject.toml: not found" without this.
			"image_build_context": "../..",
			// Default instance type ("lite") caps images at 2000MB; this image
			// is ~2.2GB (torch + fastapi + mlflow + boto3 + their deps).
			// standard-1 (4GiB memory / 8GB disk) also gives runtime headroom
			// for holding several small torch models loaded at once during a
			// real cycle, not just enough disk for the image itself.
			"instance_type": "standard-1",
			"max_instances": 3,
			// For `wrangler containers ssh <instance-id>` -- real container
			// stdout/stderr (registry-pull's output, uncaught Python tracebacks)
			// is otherwise invisible: `wrangler tail` only surfaces the Worker
			// script's own console.log, not the container process, and the
			// HTTP response body hides a 500's real cause unless
			// ANEMOI_API_DEBUG is set (see docker/api/README.md). Key is
			// dedicated to this container, not reused from anything else.
			"authorized_keys": [
				{
					"name": "claude-code-debug",
					"public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHfzRK8mp9+HLy/gd5t9a6Bx3jrKFs4s+X/HKgfRp90f anemoi-api-real-debug",
				},
			],
		},
	],

	"durable_objects": {
		"bindings": [
			{
				"name": "ANEMOI_REAL_API",
				"class_name": "AnemoiRealApi",
			},
		],
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AnemoiRealApi"],
		},
	],
}
