S3_ARTIFACT_API_ENDPOINT=your-api-endpoint-here
S3_ARTIFACT_BUCKET=your-bucket-name-here
S3_ARTIFACT_ACCESS_KEYID=your-access-key-id-here
S3_ARTIFACT_SECRET_ACCESS_KEY=your-secret-access-key-here

# MLflow tracking server (docker/mlflow/docker-compose.yml) -- Postgres
# backend store credentials. Artifacts reuse the S3_ARTIFACT_* vars above
# (same R2 bucket, mlflow-artifacts/ prefix), nothing new needed there.
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=your-mlflow-db-password-here
MLFLOW_DB_NAME=mlflow

# Real MLflow client (tracking.mlflow_client.mlflow_client_from_env, optional
# -- ModelRegistry works fine, local-JSON-only, without any of this set).
# MLFLOW_TRACKING_URI=https://mlflow.your-domain.example

# Only needed if the MLflow server above sits behind a Cloudflare Tunnel
# gated by Cloudflare Access (Zero Trust > Access > Service Auth > Service
# Tokens): picked up automatically by anemoi.tracking.cloudflare_access's
# RequestHeaderProvider plugin, added to every MLflow request. Leave unset
# for a server that isn't behind Access (e.g. local docker/mlflow/ dev).
# CF_ACCESS_CLIENT_ID=<your-service-token-client-id-here>.access
# CF_ACCESS_CLIENT_SECRET=cfast_<your-service-token-client-secret-here>


# Real SSMIS microwave radiometer data (data.real_microwave, the `microwave`
# source). Remote Sensing Systems' anonymous FTP access was discontinued
# (confirmed live: "220 Anonymous access discontinued. See
# www.remss.com/register") -- register a free account at
# https://register.remss.com/ first.
RSS_FTP_USERNAME=your-remss-username-here
RSS_FTP_PASSWORD=your-remss-password-here
