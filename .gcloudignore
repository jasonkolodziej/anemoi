# What `gcloud builds submit` uploads: only the files docker/multistage.
# Dockerfile's `training` target is built from. Without this, gcloud falls
# back to the root .gitignore alone and uploads every nested node_modules
# (~55k files).
/*
!/pyproject.toml
!/uv.lock
!/README.md
!/LICENSE
!/src/
# Read at runtime by anemoi.config (#211); the image copies it.
!/configs/
# Cloud Build's own steps (cloudbuild.yaml): build-info.json (#214) and the
# image smoke test.
!/.github/
/.github/*
!/.github/scripts/
!/docker/
/docker/*
!/docker/multistage.Dockerfile
!/docker/multistage.Dockerfile.dockerignore
!/docker/cloud-run-training/
**/__pycache__/
